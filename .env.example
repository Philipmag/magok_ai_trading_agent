# AI Trading Agent — Environment Variables
# Copy this file to .env and fill in your values.
# The system works with mock data by default — no API keys required for Phase 1.

# --- Market Data API (optional — uses mock data if left blank) ---
MARKET_API_URL=https://api.example.com/market
MARKET_API_KEY=your_market_api_key_here

# --- Shipping / Logistics API (optional) ---
SHIPPING_API_URL=https://api.example.com/shipping
SHIPPING_API_KEY=your_shipping_api_key_here

# --- News API (optional) ---
NEWS_API_URL=https://api.example.com/news
NEWS_API_KEY=your_news_api_key_here

# --- Broker API (optional — uses paper trading mock if left blank) ---
BROKER_API_URL=https://paper-trading.example.com/api
BROKER_API_KEY=your_broker_api_key_here

# --- Logging ---
LOG_LEVEL=INFO

# =============================================================================
# PHASE 3+ API Keys (for live data integration - not needed for Phase 1)
# =============================================================================

# --- Alpaca Markets (Primary broker & market data) ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# --- Polygon.io (Backup market data) ---
POLYGON_API_KEY=

# --- Marine Traffic (Live logistics data) ---
MARINE_TRAFFIC_API_KEY=

# --- NewsAPI.org (News/sentiment) ---
NEWSAPI_API_KEY=

# --- SEC EDGAR (Company filings) ---
# No API key required, but rate limits apply

# --- Quandl/FRED (Alternative signals) ---
QUANDL_API_KEY=
FRED_API_KEY=

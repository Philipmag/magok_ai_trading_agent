# AI Trading Agent - Environment Variables
# Copy this file to .env and fill in your API keys

# === PHASE 2: ML Model Configuration ===
USE_ENSEMBLE_MODEL=true
ML_CONFIDENCE_THRESHOLD=0.6
ML_RETRAIN_INTERVAL_DAYS=7
ML_LOOKBACK_DAYS=90

# === PHASE 3: Market Data APIs ===
# Alpaca Markets (primary market data)
APCA_API_KEY_ID=your_alpaca_api_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER_TRADING=true

# Polygon.io (backup market data)
POLYGON_API_KEY=your_polygon_api_key_here

# === PHASE 3: Logistics Data ===
# Marine Traffic API
MARINE_TRAFFIC_API_KEY=your_marine_traffic_key_here

# === PHASE 3: News & Sentiment ===
# NewsAPI.org
NEWS_API_KEY=your_newsapi_key_here

# SEC EDGAR (no key required, but configure user agent)
SEC_EDGAR_USER_AGENT=your_email@example.com

# === PHASE 3: Alternative Signals ===
# Quandl/FRED
QUANDL_API_KEY=your_quandl_key_here
FRED_API_KEY=your_fred_key_here

# === IBKR Fallback (Phase 6) ===
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# === General Configuration ===
LOG_LEVEL=INFO
DB_PATH=db/positions.db
MODELS_PATH=ml/models
